---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Terms & Conditions" description="The contractual agreement between nova. and our clients.">
  <section class="bg-mesh container-page flex flex-col items-center gap-6 py-24 text-center">
    <p class="eyebrow reveal">Legal</p>
    <h1 class="reveal max-w-3xl text-4xl font-bold md:text-6xl">Service Terms & Conditions</h1>
    <p class="reveal max-w-2xl text-text-muted">
      The contractual agreement between nova. and our clients.
    </p>
  </section>

  <section class="container-page section mx-auto max-w-3xl pt-0">
    <div class="card reveal p-8 md:p-10">
      <h2 class="text-left text-2xl font-bold text-accent">Scope of Work</h2>
      <p class="mt-4 leading-relaxed text-text-muted">
        All projects are governed by a detailed Statement of Work (SOW) which outlines deliverables, timelines, and
        payment schedules. Changes must be formally requested and approved.
      </p>
    </div>
  </section>
</Layout>
