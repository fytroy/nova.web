---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Privacy Policy" description="Details on how nova. collects, uses, and protects your personal data.">
  <section class="bg-mesh container-page flex flex-col items-center gap-6 py-24 text-center">
    <p class="eyebrow reveal">Legal</p>
    <h1 class="reveal max-w-3xl text-4xl font-bold md:text-6xl">Our Privacy Policy</h1>
    <p class="reveal max-w-2xl text-text-muted">
      Details on how we collect, use, and protect your personal data.
    </p>
  </section>

  <section class="container-page section mx-auto max-w-3xl pt-0">
    <div class="card reveal p-8 md:p-10">
      <h2 class="text-left text-2xl font-bold text-accent">Data Collection & Usage</h2>
      <p class="mt-4 leading-relaxed text-text-muted">
        We only collect data necessary for project communication and service delivery. We do not sell or trade your
        information with third parties.
      </p>
    </div>
  </section>
</Layout>
