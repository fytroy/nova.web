---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Thank You" description="Your project brief has been received by nova.">
  <section class="container-page flex min-h-[70vh] flex-col items-center justify-center gap-6 text-center">
    <p class="eyebrow reveal">Message Sent</p>
    <h1 class="reveal max-w-2xl text-4xl font-bold md:text-5xl">Thank You! We've Received Your Brief.</h1>
    <p class="reveal max-w-xl text-text-muted">
      We will be in touch shortly to discuss your digital future.
    </p>
    <a href="/" class="btn btn-primary reveal">Back to Home</a>
  </section>
</Layout>
