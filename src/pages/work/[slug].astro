---
import Layout from "../../layouts/Layout.astro";
import ProjectArt from "../../components/ProjectArt.astro";
import Icon from "../../components/Icon.astro";
import { projects, getProject } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug as string)!;
---

<Layout title={project.title} description={project.summary} active="portfolio">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10">
      {project.screenshot ? (
        <img src={project.screenshot} alt="" class="h-full w-full object-cover object-top opacity-20" />
      ) : (
        <div class="opacity-40"><ProjectArt id={`hero-${project.slug}`} variant={project.variant} /></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-b from-bg/40 via-bg/80 to-bg"></div>
    </div>
    <div class="container-page reveal py-24 text-center">
      <p class="eyebrow justify-center">{project.category}</p>
      <h1 class="mt-3 text-4xl font-bold md:text-6xl">{project.title}</h1>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-text-muted">{project.tagline}</p>
      <p class="mx-auto mt-4 max-w-2xl text-text-muted">{project.summary}</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn">
          <Icon name="code" class="h-4 w-4" /> View Source
        </a>
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <Icon name="rocket" class="h-4 w-4" /> Live Demo
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-surface">
    <div class="container-page grid gap-8 py-12 text-center md:grid-cols-3">
      {project.highlights.map((m) => (
        <div class="reveal">
          <div class="stat-number text-3xl md:text-4xl">{m.value}</div>
          <p class="mt-1 text-sm text-text-muted">{m.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page section grid gap-12 md:grid-cols-[1fr_18rem]">
    <div class="max-w-2xl">
      <h2 class="reveal text-left text-2xl font-bold text-accent">The Challenge</h2>
      <p class="reveal mt-4 leading-relaxed text-text-muted">{project.challenge}</p>

      <h2 class="reveal mt-12 text-left text-2xl font-bold text-accent">Our Solution</h2>
      <p class="reveal mt-4 leading-relaxed text-text-muted">{project.solution}</p>

      <h2 class="reveal mt-12 text-left text-2xl font-bold text-accent">Outcome</h2>
      <p class="reveal mt-4 leading-relaxed text-text-muted">{project.impact}</p>

      <div class="reveal mt-16 flex flex-wrap gap-3">
        <a href="/portfolio" class="btn btn-primary">Back to Portfolio</a>
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn">View Source on GitHub</a>
      </div>
    </div>

    <aside class="reveal h-fit space-y-6 self-start rounded-xl border border-border bg-surface p-6 md:sticky md:top-24">
      <p class="eyebrow justify-start">Project Snapshot</p>
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="text-text-muted">Status</dt>
          <dd class="mt-1 font-semibold text-text">{project.status}</dd>
        </div>
        <div>
          <dt class="text-text-muted">Role</dt>
          <dd class="mt-1 font-semibold text-text">{project.role}</dd>
        </div>
      </dl>
      <div class="border-t border-border pt-4">
        <p class="text-sm text-text-muted">Stack</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {project.techStack.map((t) => (
            <li class="rounded-full bg-accent-dim px-3 py-1 text-xs font-semibold text-accent">{t}</li>
          ))}
        </ul>
      </div>
      <div class="flex flex-col gap-2 border-t border-border pt-4">
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn justify-center">
          <Icon name="code" class="h-4 w-4" /> Source
        </a>
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary justify-center">
            <Icon name="rocket" class="h-4 w-4" /> Live Demo
          </a>
        )}
      </div>
    </aside>
  </section>
</Layout>
