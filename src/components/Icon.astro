---
interface Props {
  name: "code" | "layers" | "cloud" | "shield" | "rocket" | "chart" | "search" | "sparkle" | "chat" | "gauge";
  class?: string;
}
const { name, class: className = "h-6 w-6" } = Astro.props;
---

{name === "code" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M9 18 3 12l6-6M15 6l6 6-6 6" />
  </svg>
)}

{name === "layers" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M12 3 3 8l9 5 9-5-9-5Z" />
    <path d="M3 13l9 5 9-5" />
  </svg>
)}

{name === "cloud" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M7 18h10a4 4 0 0 0 .6-7.96A5.5 5.5 0 0 0 7.1 8.51 4.5 4.5 0 0 0 7 18Z" />
  </svg>
)}

{name === "shield" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M12 3l8 3v6c0 4.5-3.4 7.5-8 9-4.6-1.5-8-4.5-8-9V6l8-3Z" />
    <path d="M9 12l2 2 4-4" />
  </svg>
)}

{name === "rocket" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M12 14c4-2 6-6 5-11-5-1-9 1-11 5-2 3-1 6 1 8 2 2 5 0 5-2Z" />
    <path d="M9 15l-3 3M15 18l3-3M7 12 4 13l1-3M12 19l-1 3 3-1" />
  </svg>
)}

{name === "chart" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M4 20V10M12 20V4M20 20v-7" />
  </svg>
)}

{name === "search" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <circle cx="10.5" cy="10.5" r="6.5" />
    <path d="M20 20l-4.6-4.6" />
  </svg>
)}

{name === "sparkle" && (
  <svg viewBox="0 0 24 24" fill="currentColor" class={className}>
    <path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2Z" />
  </svg>
)}

{name === "chat" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M4 5h16v10H9l-4 4V5Z" />
  </svg>
)}

{name === "gauge" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M4 16a8 8 0 1 1 16 0" />
    <path d="M12 16l4-5" />
  </svg>
)}
