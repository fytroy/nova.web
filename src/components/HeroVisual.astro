---
import Icon from "./Icon.astro";
---

<div class="reveal relative mx-auto w-full max-w-md">
  <div class="absolute -inset-10 -z-10 rounded-full bg-accent/20 blur-3xl"></div>

  <div class="rounded-2xl border border-border bg-surface/90 p-5 shadow-2xl backdrop-blur">
    <div class="flex items-center gap-2 border-b border-border pb-3">
      <span class="h-2.5 w-2.5 rounded-full bg-accent/70"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-violet/70"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-text-muted/40"></span>
      <span class="ml-3 h-2 flex-1 rounded-full bg-bg"></span>
    </div>

    <div class="mt-5 space-y-3">
      <div class="h-3 w-3/4 rounded-full bg-bg"></div>
      <div class="h-3 w-1/2 rounded-full bg-bg"></div>
    </div>

    <div class="mt-6 flex items-end gap-2">
      <div class="h-12 w-1/4 rounded-md bg-accent/20"></div>
      <div class="h-20 w-1/4 rounded-md bg-accent/40"></div>
      <div class="h-8 w-1/4 rounded-md bg-accent/20"></div>
      <div class="h-24 w-1/4 rounded-md bg-gradient-to-t from-accent to-accent-soft"></div>
    </div>

    <div class="mt-6 flex items-center justify-between rounded-xl border border-border bg-bg p-3">
      <div class="space-y-2">
        <div class="h-2 w-20 rounded-full bg-surface-hover"></div>
        <div class="h-2 w-12 rounded-full bg-surface-hover"></div>
      </div>
      <span class="rounded-full bg-accent px-3 py-1 text-xs font-bold text-bg">Live</span>
    </div>
  </div>

  <div class="absolute -bottom-6 -left-6 rounded-xl border border-border bg-surface px-4 py-3 shadow-xl">
    <p class="text-2xl font-bold stat-number">98</p>
    <p class="text-[10px] uppercase tracking-wide text-text-muted">Lighthouse Score</p>
  </div>

  <div class="absolute -right-4 -top-4 flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2 shadow-xl">
    <Icon name="sparkle" class="h-4 w-4 text-accent" />
    <span class="text-xs font-semibold text-text">Built for scale</span>
  </div>
</div>
