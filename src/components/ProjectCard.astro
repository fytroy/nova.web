---
import ProjectArt from "./ProjectArt.astro";

interface Props {
  slug: string;
  title: string;
  tags: string;
  summary: string;
  variant: 1 | 2 | 3 | 4;
  status: string;
  screenshot?: string;
}
const { slug, title, tags, summary, variant, status, screenshot } = Astro.props;
---

<div class="card reveal overflow-hidden">
  <div class="aspect-video overflow-hidden">
    {screenshot ? (
      <img src={screenshot} alt={`${title} screenshot`} class="h-full w-full object-cover object-top" loading="lazy" />
    ) : (
      <ProjectArt id={slug} variant={variant} />
    )}
  </div>
  <div class="p-6">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-lg font-bold text-text">{title}</h3>
      <span class="shrink-0 rounded-full bg-accent-dim px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-accent">{status}</span>
    </div>
    <p class="mt-1 text-xs uppercase tracking-wide text-text-muted">{tags}</p>
    <p class="mt-3 text-sm leading-relaxed text-text-muted">{summary}</p>
    <a href={`/work/${slug}`} class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-accent hover:text-accent-soft">
      See Details &rarr;
    </a>
  </div>
</div>
