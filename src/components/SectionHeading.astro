---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
}
const { eyebrow, title, subtitle, align = "center" } = Astro.props;
const alignClass = align === "center" ? "mx-auto text-center" : "text-left";
---

<div class:list={["reveal max-w-2xl", alignClass]}>
  <p class:list={["eyebrow", align === "center" ? "justify-center" : "justify-start"]}>{eyebrow}</p>
  <h2 class="mt-4 text-3xl font-bold md:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-text-muted">{subtitle}</p>}
</div>
