---
interface Props {
  id: string;
  variant?: 1 | 2 | 3 | 4;
}
const { id, variant = 1 } = Astro.props;

const palettes: Record<number, [string, string]> = {
  1: ["#22e0a8", "#0a4438"],
  2: ["#3bb6e8", "#0a2f44"],
  3: ["#c98be8", "#2a1144"],
  4: ["#e0b422", "#3d2c0a"],
};
const [from, to] = palettes[variant];
const gradId = `grad-${id}`;
---

<svg
  viewBox="0 0 400 250"
  class="h-full w-full"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="Abstract project artwork"
>
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={from} />
      <stop offset="100%" stop-color={to} />
    </linearGradient>
  </defs>
  <rect width="400" height="250" fill="#0c0d10" />
  <rect width="400" height="250" fill={`url(#${gradId})`} opacity="0.35" />
  <circle cx="80" cy="60" r="90" fill={from} opacity="0.18" />
  <circle cx="330" cy="200" r="120" fill={to} opacity="0.35" />
  <g stroke={from} stroke-opacity="0.4" stroke-width="1">
    <line x1="0" y1="200" x2="400" y2="120" />
    <line x1="0" y1="160" x2="400" y2="60" />
  </g>
</svg>
